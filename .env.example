EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_RECEIPT_VERIFY_URL=https://YOUR_DOMAIN/receipt
EXPO_PUBLIC_UPDATE_MANIFEST_URL=https://YOUR_DOMAIN/releases/release.json
EXPO_PUBLIC_PAYMENT_MODEL=platform_wallet

# Backend-only production secrets belong in Supabase/EAS secret storage.
# Never prefix these with EXPO_PUBLIC_ and never commit their values.
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_ENVIRONMENT=production
# MIDTRANS_IS_PRODUCTION=true
# PLATFORM_PAYMENT_MODEL=platform_wallet
# PLATFORM_FEE_BPS=
# PLATFORM_RESERVE_BPS=
# APP_DEEP_LINK_URL=niagacore://auth/callback
# APP_PASSWORD_RESET_DEEP_LINK_URL=niagacore://auth/reset
# WALLET_ENCRYPTION_KEY_BASE64=
# AI_PROVIDER_ORDER=cloudflare,gemini
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
# CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# NIA_EVALUATION_CRON_SECRET=GENERATE_A_RANDOM_SECRET_MINIMUM_24_CHARACTERS
# NOTIFICATION_CRON_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET_MINIMUM_24_CHARACTERS
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=SERVER_SIDE_TOKEN_WITH_PROJECT_READ
