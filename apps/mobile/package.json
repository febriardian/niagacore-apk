{
  "name": "@niagacore/mobile",
  "version": "2.12.0",
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-ml-kit/text-recognition"
        ]
      }
    }
  },
  "main": "expo-router/entry",
  "scripts": {
